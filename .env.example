# Required: set this before running
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]

# Optional overrides. The accounting API key defaults to the mock key published
# in TAKE_HOME.md, so it only needs setting if you point at a different host.
OPENAI_MODEL=gpt-4o
ACCOUNTING_API_URL=http://localhost:8080
# ACCOUNTING_API_KEY=

# Issue-date plausibility window, in days, used to catch era-year misreads
INVOICE_MAX_AGE_DAYS=730
INVOICE_MAX_FUTURE_DAYS=30
